# Modèle : copie ce fichier en .env.local et remplis les valeurs (jamais de vraies clés ici).
# En local, utilise des clés de test (Stripe sk_test_..., un projet Supabase de test).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (STRIPE_SECRET_KEY est obligatoire pour le build)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# OpenAI (génération des fiches)
OPENAI_API_KEY=

# Emails (Resend + tâches planifiées)
RESEND_API_KEY=
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# "oui" pour activer les mails automatiques
EMAILS_AUTO=

# Google Analytics (facultatif)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Connexion « Continuer avec Google » : "oui" pour afficher le bouton (à configurer d'abord, voir docs/google-login.md)
NEXT_PUBLIC_GOOGLE_LOGIN=
